<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinnersPortal.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinnersPortal.Services\WinnersPortal.Services.csproj" />
    <ProjectReference Include="..\WinnersPortal.Domain\WinnersPortal.Domain.csproj" />
    <ProjectReference Include="..\WinnersPortal.Infrastructure\WinnersPortal.Infrastructure.csproj" />
    <!-- The SQL Server migration tree: nothing here calls into it, but the
         provider loads it by name at startup, so it has to be in the output. -->
    <ProjectReference Include="..\WinnersPortal.Migrations.SqlServer\WinnersPortal.Migrations.SqlServer.csproj" />
  </ItemGroup>

  <!-- The web edge: controllers, middleware, the hub, and the host. The
       integrations' packages belong to the application tier now; what is
       left here is authentication, the design-time EF tooling (dotnet-ef
       starts from this project) and the provider Program.cs wires up. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
  </ItemGroup>

</Project>
